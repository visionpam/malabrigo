generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
}

enum MemberStatus {
  PROSPECT
  ACTIVE
  IN_ARREARS
  SUSPENDED
  WITHDRAWN
}

enum ProgramKind {
  FOUNDATION
  PLUS
  PREMIUM
  FAMILIAR
  VIP
}

enum MaritalStatus {
  SINGLE
  MARRIED
  COHABITING
  DIVORCED
  WIDOWED
  OTHER
}

enum AmbassadorStatus {
  PENDING
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REVERSED
}

enum SaleMode {
  CASH
  CREDIT
}

enum SaleStatus {
  DRAFT
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  IN_REVIEW
  PAID
  OVERDUE
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  CONFIRMED
  VOIDED
}

enum PaymentConcept {
  SEPARATION
  DOWN_PAYMENT
  INSTALLMENT
  OTHER
}

enum AllocationKind {
  SHARES
  STAY_DAYS
}

enum ContractStatus {
  DRAFT
  GENERATED
  SENT
  SIGNED
  VOIDED
}

enum DocumentCategory {
  IDENTITY
  SEPARATION_FORM
  SEPARATION_PROOF
  SALE_PROOF
  SIGNED_CONTRACT
  ANNEX
  RENDER
  PROJECT
  TIMELINE
  CONSTRUCTION_PROGRESS
  CABINS
  PLANS
  CONTRACT_MODEL
  OTHER
}

enum DocumentVisibility {
  PRIVATE_MEMBER
  ALL_MEMBERS
  ADMIN_ONLY
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                String               @id @default(uuid()) @db.Uuid
  email             String               @unique @db.VarChar(255)
  passwordHash      String?              @map("password_hash") @db.VarChar(255)
  displayName       String               @map("display_name") @db.VarChar(160)
  status            UserStatus           @default(INVITED)
  lastLoginAt       DateTime?            @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  member            Member?
  roles             UserRole[]
  auditEntries      AuditLog[]           @relation("AuditActor")
  invitations       AccountInvitation[]
  passwordResets    PasswordResetToken[]
  sessions          UserSession[]
  permissions       UserPermission[]
  uploadedDocuments DocumentRecord[]     @relation("DocumentUploader")

  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(40)
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(300)
  assignments UserRole[]

  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(300)
  assignments UserPermission[]

  @@map("permissions")
}

model UserPermission {
  userId       String     @map("user_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  assignedAt   DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

model Member {
  id                 String             @id @default(uuid()) @db.Uuid
  memberCode         String             @unique @map("member_code") @db.Char(7)
  userId             String?            @unique @map("user_id") @db.Uuid
  documentType       String             @map("document_type") @db.VarChar(20)
  documentNumber     String             @map("document_number") @db.VarChar(40)
  firstName          String             @map("first_name") @db.VarChar(100)
  lastName           String             @map("last_name") @db.VarChar(100)
  countryCode        String             @default("PE") @map("country_code") @db.Char(2)
  phone              String?            @db.VarChar(30)
  email              String             @db.VarChar(255)
  residence          String?            @db.VarChar(180)
  occupation         String?            @db.VarChar(140)
  maritalStatus      MaritalStatus?     @map("marital_status")
  status             MemberStatus       @default(PROSPECT)
  joinedAt           DateTime?          @map("joined_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  sales              Sale[]
  referralCode       ReferralCode?
  sponsorshipAsChild Sponsorship?       @relation("SponsoredMember")
  sponsorships       Sponsorship[]      @relation("SponsorMember")
  legalAcceptances   LegalAcceptance[]
  investorProfile    InvestorProfile?
  ambassadorProfile  AmbassadorProfile?
  beneficiaries      Beneficiary[]      @relation("InvestmentHolder")
  documents          DocumentRecord[]

  @@unique([documentType, documentNumber])
  @@index([email])
  @@map("members")
}

model InvestorProfile {
  id          String             @id @default(uuid()) @db.Uuid
  memberId    String             @unique @map("member_id") @db.Uuid
  sponsorId   String?            @map("sponsor_id") @db.Uuid
  status      MemberStatus       @default(PROSPECT)
  activatedAt DateTime?          @map("activated_at") @db.Timestamptz(6)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  member      Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sponsor     AmbassadorProfile? @relation("InvestorSponsorship", fields: [sponsorId], references: [id], onDelete: Restrict)

  @@index([sponsorId])
  @@map("investor_profiles")
}

model AmbassadorProfile {
  id           String                  @id @default(uuid()) @db.Uuid
  memberId     String                  @unique @map("member_id") @db.Uuid
  referralCode String                  @unique @map("referral_code") @db.Char(7)
  sponsorId    String?                 @map("sponsor_id") @db.Uuid
  status       AmbassadorStatus        @default(PENDING)
  currentRank  String?                 @map("current_rank") @db.VarChar(30)
  affiliatedAt DateTime                @default(now()) @map("affiliated_at") @db.Timestamptz(6)
  member       Member                  @relation(fields: [memberId], references: [id], onDelete: Restrict)
  sponsor      AmbassadorProfile?      @relation("AmbassadorNetwork", fields: [sponsorId], references: [id], onDelete: Restrict)
  referrals    AmbassadorProfile[]     @relation("AmbassadorNetwork")
  investors    InvestorProfile[]       @relation("InvestorSponsorship")
  commissions  CommissionEntry[]
  rankHistory  AmbassadorRankHistory[]
  rankBonuses  RankBonusPayment[]
  awards       RankAward[]

  @@index([sponsorId])
  @@map("ambassador_profiles")
}

model Beneficiary {
  id           String   @id @default(uuid()) @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(180)
  document     String?  @db.VarChar(60)
  relationship String   @db.VarChar(60)
  isSpouse     Boolean  @default(false) @map("is_spouse")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  holder       Member   @relation("InvestmentHolder", fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("beneficiaries")
}

model Program {
  id                    String           @id @default(uuid()) @db.Uuid
  kind                  ProgramKind      @unique
  name                  String           @db.VarChar(120)
  cashPrice             Decimal          @map("cash_price") @db.Decimal(18, 2)
  separation            Decimal          @db.Decimal(18, 2)
  cashShares            Int?             @map("cash_shares")
  cashStayDays          Int?             @map("cash_stay_days")
  beneficiaryCap        Int              @map("beneficiary_cap")
  marriedBeneficiaryCap Int              @default(0) @map("married_beneficiary_cap")
  membershipName        String?          @map("membership_name") @db.VarChar(160)
  shareholderCategory   String?          @map("shareholder_category") @db.VarChar(80)
  observations          String?          @db.VarChar(500)
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  financingPlans        FinancingPlan[]
  sales                 Sale[]
  commissionRules       CommissionRule[]

  @@map("programs")
}

model FinancingPlan {
  id              String  @id @default(uuid()) @db.Uuid
  programId       String  @map("program_id") @db.Uuid
  termMonths      Int     @map("term_months")
  downPayment     Decimal @map("down_payment") @db.Decimal(18, 2)
  financedAmount  Decimal @map("financed_amount") @db.Decimal(18, 2)
  monthlyPayment  Decimal @map("monthly_payment") @db.Decimal(18, 2)
  sharesGranted   Int?    @map("shares_granted")
  stayDaysGranted Int?    @map("stay_days_granted")
  active          Boolean @default(true)
  program         Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  sales           Sale[]

  @@unique([programId, termMonths])
  @@map("financing_plans")
}

model Sale {
  id                 String              @id @default(uuid()) @db.Uuid
  code               String              @unique @db.VarChar(30)
  memberId           String              @map("member_id") @db.Uuid
  programId          String              @map("program_id") @db.Uuid
  financingPlanId    String?             @map("financing_plan_id") @db.Uuid
  mode               SaleMode
  status             SaleStatus          @default(DRAFT)
  currency           String              @default("USD") @db.Char(3)
  totalPrice         Decimal             @map("total_price") @db.Decimal(18, 2)
  separationAmount   Decimal             @map("separation_amount") @db.Decimal(18, 2)
  downPaymentAmount  Decimal             @default(0) @map("down_payment_amount") @db.Decimal(18, 2)
  signedAt           DateTime?           @map("signed_at") @db.Timestamptz(6)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  member             Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program            Program             @relation(fields: [programId], references: [id], onDelete: Restrict)
  financingPlan      FinancingPlan?      @relation(fields: [financingPlanId], references: [id], onDelete: Restrict)
  installments       Installment[]
  paymentSubmissions PaymentSubmission[]
  payments           Payment[]
  shareAllocation    ShareAllocation?
  stayAllocation     StayAllocation?
  contracts          Contract[]
  documents          DocumentRecord[]

  @@index([memberId, status])
  @@index([createdAt])
  @@map("sales")
}

model Installment {
  id          String              @id @default(uuid()) @db.Uuid
  saleId      String              @map("sale_id") @db.Uuid
  number      Int
  amount      Decimal             @db.Decimal(18, 2)
  dueDate     DateTime            @map("due_date") @db.Date
  status      InstallmentStatus   @default(PENDING)
  paidAmount  Decimal             @default(0) @map("paid_amount") @db.Decimal(18, 2)
  sale        Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([saleId, number])
  @@index([status, dueDate])
  @@map("installments")
}

model PaymentSubmission {
  id              String           @id @default(uuid()) @db.Uuid
  saleId          String           @map("sale_id") @db.Uuid
  amount          Decimal          @db.Decimal(18, 2)
  concept         PaymentConcept   @default(OTHER)
  currency        String           @default("USD") @db.Char(3)
  voucherUrl      String           @map("voucher_url") @db.Text
  submittedAt     DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt      DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  status          SubmissionStatus @default(PENDING)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  sale            Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  payment         Payment?

  @@index([status, submittedAt])
  @@map("payment_submissions")
}

model Payment {
  id           String              @id @default(uuid()) @db.Uuid
  saleId       String              @map("sale_id") @db.Uuid
  submissionId String?             @unique @map("submission_id") @db.Uuid
  reference    String              @unique @db.VarChar(60)
  amount       Decimal             @db.Decimal(18, 2)
  concept      PaymentConcept      @default(OTHER)
  currency     String              @default("USD") @db.Char(3)
  paidAt       DateTime            @map("paid_at") @db.Timestamptz(6)
  confirmedAt  DateTime            @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  status       PaymentStatus       @default(CONFIRMED)
  sale         Sale                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  submission   PaymentSubmission?  @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  allocations  PaymentAllocation[]

  @@index([saleId, paidAt])
  @@index([saleId, concept, status])
  @@map("payments")
}

model PaymentAllocation {
  id            String      @id @default(uuid()) @db.Uuid
  paymentId     String      @map("payment_id") @db.Uuid
  installmentId String      @map("installment_id") @db.Uuid
  amount        Decimal     @db.Decimal(18, 2)
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, installmentId])
  @@map("payment_allocations")
}

model ShareAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @unique @map("sale_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@map("share_allocations")
}

model StayAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @unique @map("sale_id") @db.Uuid
  days      Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@map("stay_allocations")
}

model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @unique @map("member_id") @db.Uuid
  code      String   @unique @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@map("referral_codes")
}

model Sponsorship {
  id        String   @id @default(uuid()) @db.Uuid
  childId   String   @unique @map("child_id") @db.Uuid
  sponsorId String   @map("sponsor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  child     Member   @relation("SponsoredMember", fields: [childId], references: [id], onDelete: Restrict)
  sponsor   Member   @relation("SponsorMember", fields: [sponsorId], references: [id], onDelete: Restrict)

  @@index([sponsorId])
  @@map("sponsorships")
}

model ProjectStage {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(160)
  description String?         @db.Text
  weight      Decimal         @db.Decimal(5, 2)
  startsAt    DateTime?       @map("starts_at") @db.Date
  endsAt      DateTime?       @map("ends_at") @db.Date
  sortOrder   Int             @map("sort_order")
  updates     ProjectUpdate[]

  @@map("project_stages")
}

model ProjectUpdate {
  id          String         @id @default(uuid()) @db.Uuid
  stageId     String         @map("stage_id") @db.Uuid
  title       String         @db.VarChar(180)
  description String         @db.Text
  progress    Decimal        @db.Decimal(5, 2)
  occurredAt  DateTime       @map("occurred_at") @db.Date
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  stage       ProjectStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  media       ProjectMedia[]

  @@index([publishedAt])
  @@map("project_updates")
}

model ProjectMedia {
  id        String        @id @default(uuid()) @db.Uuid
  updateId  String        @map("update_id") @db.Uuid
  url       String        @db.Text
  altText   String        @map("alt_text") @db.VarChar(220)
  sortOrder Int           @map("sort_order")
  update    ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@map("project_media")
}

model DocumentRecord {
  id              String             @id @default(uuid()) @db.Uuid
  memberId        String?            @map("member_id") @db.Uuid
  saleId          String?            @map("sale_id") @db.Uuid
  uploadedById    String?            @map("uploaded_by_id") @db.Uuid
  category        DocumentCategory
  visibility      DocumentVisibility @default(PRIVATE_MEMBER)
  status          DocumentStatus     @default(PENDING)
  title           String             @db.VarChar(180)
  url             String             @db.Text
  rejectionReason String?            @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewedAt      DateTime?          @map("reviewed_at") @db.Timestamptz(6)
  member          Member?            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  sale            Sale?              @relation(fields: [saleId], references: [id], onDelete: Cascade)
  uploadedBy      User?              @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([memberId, category])
  @@index([visibility, status])
  @@map("document_records")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.VarChar(100)
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ContractTemplate {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @db.VarChar(60)
  name      String     @db.VarChar(160)
  version   Int
  content   String     @db.Text
  active    Boolean    @default(true)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  contracts Contract[]

  @@unique([code, version])
  @@map("contract_templates")
}

model Contract {
  id          String            @id @default(uuid()) @db.Uuid
  saleId      String            @map("sale_id") @db.Uuid
  templateId  String            @map("template_id") @db.Uuid
  status      ContractStatus    @default(DRAFT)
  documentUrl String?           @map("document_url") @db.Text
  generatedAt DateTime?         @map("generated_at") @db.Timestamptz(6)
  signedAt    DateTime?         @map("signed_at") @db.Timestamptz(6)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  sale        Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  template    ContractTemplate  @relation(fields: [templateId], references: [id], onDelete: Restrict)
  acceptances LegalAcceptance[]

  @@index([status, createdAt])
  @@index([saleId])
  @@map("contracts")
}

model LegalAcceptance {
  id         String    @id @default(uuid()) @db.Uuid
  memberId   String    @map("member_id") @db.Uuid
  contractId String?   @map("contract_id") @db.Uuid
  type       String    @db.VarChar(80)
  version    String    @db.VarChar(40)
  acceptedAt DateTime  @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipAddress  String?   @map("ip_address") @db.Inet
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  evidence   Json?
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([memberId, acceptedAt])
  @@map("legal_acceptances")
}

model AccountInvitation {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  sentAt     DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("account_invitations")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model CommissionRule {
  id          String    @id @default(uuid()) @db.Uuid
  programId   String?   @map("program_id") @db.Uuid
  mode        SaleMode?
  generation  Int       @default(0)
  fixedAmount Decimal?  @map("fixed_amount") @db.Decimal(18, 2)
  percentage  Decimal?  @db.Decimal(7, 4)
  points      Int       @default(0)
  version     Int       @default(1)
  active      Boolean   @default(true)
  program     Program?  @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@unique([programId, mode, generation, version])
  @@map("commission_rules")
}

model CommissionEntry {
  id              String            @id @default(uuid()) @db.Uuid
  ambassadorId    String            @map("ambassador_id") @db.Uuid
  sourceSaleId    String            @map("source_sale_id") @db.Uuid
  sourcePaymentId String?           @map("source_payment_id") @db.Uuid
  generation      Int
  amount          Decimal           @db.Decimal(18, 2)
  points          Int               @default(0)
  status          CommissionStatus  @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  ambassador      AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)

  @@unique([ambassadorId, sourcePaymentId, generation])
  @@index([ambassadorId, status])
  @@index([sourceSaleId])
  @@map("commission_entries")
}

model RankDefinition {
  code              String                  @id @db.VarChar(30)
  name              String                  @db.VarChar(60)
  sortOrder         Int                     @unique @map("sort_order")
  memberCount       Int                     @map("member_count")
  directCount       Int                     @map("direct_count")
  directPoints      Int                     @map("direct_points")
  totalPoints       Int                     @map("total_points")
  deadlineMonths    Int                     @map("deadline_months")
  monthlyBonus      Decimal                 @map("monthly_bonus") @db.Decimal(18, 2)
  rewardName        String?                 @map("reward_name") @db.VarChar(140)
  rewardDescription String?                 @map("reward_description") @db.VarChar(400)
  history           AmbassadorRankHistory[]
  bonuses           RankBonusPayment[]
  awards            RankAward[]

  @@map("rank_definitions")
}

model AmbassadorRankHistory {
  id           String            @id @default(uuid()) @db.Uuid
  ambassadorId String            @map("ambassador_id") @db.Uuid
  rankCode     String            @map("rank_code") @db.VarChar(30)
  achievedAt   DateTime          @default(now()) @map("achieved_at") @db.Timestamptz(6)
  snapshot     Json
  ambassador   AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)
  rank         RankDefinition    @relation(fields: [rankCode], references: [code], onDelete: Restrict)

  @@unique([ambassadorId, rankCode])
  @@map("ambassador_rank_history")
}

model RankBonusPayment {
  id           String            @id @default(uuid()) @db.Uuid
  ambassadorId String            @map("ambassador_id") @db.Uuid
  rankCode     String            @map("rank_code") @db.VarChar(30)
  period       DateTime          @db.Date
  amount       Decimal           @db.Decimal(18, 2)
  status       CommissionStatus  @default(PENDING)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  ambassador   AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)
  rank         RankDefinition    @relation(fields: [rankCode], references: [code], onDelete: Restrict)

  @@unique([ambassadorId, period])
  @@index([status, period])
  @@map("rank_bonus_payments")
}

model RankAward {
  id           String            @id @default(uuid()) @db.Uuid
  ambassadorId String            @map("ambassador_id") @db.Uuid
  rankCode     String            @map("rank_code") @db.VarChar(30)
  status       String            @default("EARNED") @db.VarChar(30)
  earnedAt     DateTime          @default(now()) @map("earned_at") @db.Timestamptz(6)
  deliveredAt  DateTime?         @map("delivered_at") @db.Timestamptz(6)
  notes        String?           @db.VarChar(500)
  ambassador   AmbassadorProfile @relation(fields: [ambassadorId], references: [id], onDelete: Restrict)
  rank         RankDefinition    @relation(fields: [rankCode], references: [code], onDelete: Restrict)

  @@unique([ambassadorId, rankCode])
  @@index([status])
  @@map("rank_awards")
}
