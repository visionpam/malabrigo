generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum MemberStatus {
  PROSPECT
  ACTIVE
  IN_ARREARS
  SUSPENDED
  WITHDRAWN
}

enum ProgramKind {
  PLUS
  PREMIUM
  FAMILIAR
  VIP
}

enum SaleMode {
  CASH
  CREDIT
}

enum SaleStatus {
  DRAFT
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  IN_REVIEW
  PAID
  OVERDUE
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  CONFIRMED
  VOIDED
}

enum PaymentConcept {
  SEPARATION
  DOWN_PAYMENT
  INSTALLMENT
  OTHER
}

enum AllocationKind {
  SHARES
  STAY_DAYS
}

enum ContractStatus {
  DRAFT
  GENERATED
  SENT
  SIGNED
  VOIDED
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique @db.VarChar(255)
  passwordHash String?      @map("password_hash") @db.VarChar(255)
  displayName  String       @map("display_name") @db.VarChar(160)
  status       UserStatus   @default(INVITED)
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  member       Member?
  roles        UserRole[]
  auditEntries AuditLog[]   @relation("AuditActor")

  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique @db.VarChar(40)
  name        String     @db.VarChar(100)
  description String?    @db.VarChar(300)
  assignments UserRole[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Member {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String?      @unique @map("user_id") @db.Uuid
  documentType      String       @map("document_type") @db.VarChar(20)
  documentNumber    String       @map("document_number") @db.VarChar(40)
  firstName         String       @map("first_name") @db.VarChar(100)
  lastName          String       @map("last_name") @db.VarChar(100)
  countryCode       String       @default("PE") @map("country_code") @db.Char(2)
  phone             String?      @db.VarChar(30)
  email             String       @db.VarChar(255)
  status            MemberStatus @default(PROSPECT)
  joinedAt          DateTime?    @map("joined_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sales             Sale[]
  referralCode      ReferralCode?
  sponsorshipAsChild Sponsorship? @relation("SponsoredMember")
  sponsorships      Sponsorship[] @relation("SponsorMember")
  legalAcceptances  LegalAcceptance[]

  @@unique([documentType, documentNumber])
  @@index([email])
  @@map("members")
}

model Program {
  id             String          @id @default(uuid()) @db.Uuid
  kind           ProgramKind     @unique
  name           String          @db.VarChar(120)
  cashPrice      Decimal         @map("cash_price") @db.Decimal(18, 2)
  separation     Decimal         @db.Decimal(18, 2)
  cashShares     Int?            @map("cash_shares")
  cashStayDays   Int?            @map("cash_stay_days")
  beneficiaryCap Int             @map("beneficiary_cap")
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  financingPlans FinancingPlan[]
  sales          Sale[]

  @@map("programs")
}

model FinancingPlan {
  id             String   @id @default(uuid()) @db.Uuid
  programId      String   @map("program_id") @db.Uuid
  termMonths     Int      @map("term_months")
  downPayment    Decimal  @map("down_payment") @db.Decimal(18, 2)
  financedAmount Decimal  @map("financed_amount") @db.Decimal(18, 2)
  monthlyPayment Decimal  @map("monthly_payment") @db.Decimal(18, 2)
  sharesGranted  Int?     @map("shares_granted")
  stayDaysGranted Int?    @map("stay_days_granted")
  active         Boolean  @default(true)
  program        Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  sales          Sale[]

  @@unique([programId, termMonths])
  @@map("financing_plans")
}

model Sale {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique @db.VarChar(30)
  memberId         String       @map("member_id") @db.Uuid
  programId        String       @map("program_id") @db.Uuid
  financingPlanId  String?      @map("financing_plan_id") @db.Uuid
  mode             SaleMode
  status           SaleStatus   @default(DRAFT)
  currency         String       @default("USD") @db.Char(3)
  totalPrice       Decimal      @map("total_price") @db.Decimal(18, 2)
  separationAmount Decimal      @map("separation_amount") @db.Decimal(18, 2)
  downPaymentAmount Decimal     @default(0) @map("down_payment_amount") @db.Decimal(18, 2)
  signedAt         DateTime?    @map("signed_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  member           Member       @relation(fields: [memberId], references: [id], onDelete: Restrict)
  program          Program      @relation(fields: [programId], references: [id], onDelete: Restrict)
  financingPlan    FinancingPlan? @relation(fields: [financingPlanId], references: [id], onDelete: Restrict)
  installments     Installment[]
  paymentSubmissions PaymentSubmission[]
  payments         Payment[]
  shareAllocation  ShareAllocation?
  stayAllocation   StayAllocation?
  contracts         Contract[]

  @@index([memberId, status])
  @@index([createdAt])
  @@map("sales")
}

model Installment {
  id          String            @id @default(uuid()) @db.Uuid
  saleId      String            @map("sale_id") @db.Uuid
  number      Int
  amount      Decimal           @db.Decimal(18, 2)
  dueDate     DateTime          @map("due_date") @db.Date
  status      InstallmentStatus @default(PENDING)
  paidAmount  Decimal           @default(0) @map("paid_amount") @db.Decimal(18, 2)
  sale        Sale              @relation(fields: [saleId], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]

  @@unique([saleId, number])
  @@index([status, dueDate])
  @@map("installments")
}

model PaymentSubmission {
  id           String           @id @default(uuid()) @db.Uuid
  saleId       String           @map("sale_id") @db.Uuid
  amount       Decimal          @db.Decimal(18, 2)
  currency     String           @default("USD") @db.Char(3)
  voucherUrl   String           @map("voucher_url") @db.Text
  submittedAt  DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  status       SubmissionStatus @default(PENDING)
  rejectionReason String?       @map("rejection_reason") @db.VarChar(500)
  sale         Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  payment      Payment?

  @@index([status, submittedAt])
  @@map("payment_submissions")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  saleId         String        @map("sale_id") @db.Uuid
  submissionId   String?       @unique @map("submission_id") @db.Uuid
  reference      String        @unique @db.VarChar(60)
  amount         Decimal       @db.Decimal(18, 2)
  concept        PaymentConcept @default(OTHER)
  currency       String        @default("USD") @db.Char(3)
  paidAt         DateTime      @map("paid_at") @db.Timestamptz(6)
  confirmedAt    DateTime      @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  status         PaymentStatus @default(CONFIRMED)
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  submission     PaymentSubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  allocations    PaymentAllocation[]

  @@index([saleId, paidAt])
  @@index([saleId, concept, status])
  @@map("payments")
}

model PaymentAllocation {
  id            String      @id @default(uuid()) @db.Uuid
  paymentId     String      @map("payment_id") @db.Uuid
  installmentId String      @map("installment_id") @db.Uuid
  amount        Decimal     @db.Decimal(18, 2)
  payment       Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  installment   Installment @relation(fields: [installmentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, installmentId])
  @@map("payment_allocations")
}

model ShareAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @unique @map("sale_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@map("share_allocations")
}

model StayAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  saleId    String   @unique @map("sale_id") @db.Uuid
  days      Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@map("stay_allocations")
}

model ReferralCode {
  id        String   @id @default(uuid()) @db.Uuid
  memberId  String   @unique @map("member_id") @db.Uuid
  code      String   @unique @db.VarChar(20)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@map("referral_codes")
}

model Sponsorship {
  id        String   @id @default(uuid()) @db.Uuid
  childId   String   @unique @map("child_id") @db.Uuid
  sponsorId String   @map("sponsor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  child     Member   @relation("SponsoredMember", fields: [childId], references: [id], onDelete: Restrict)
  sponsor   Member   @relation("SponsorMember", fields: [sponsorId], references: [id], onDelete: Restrict)

  @@index([sponsorId])
  @@map("sponsorships")
}

model ProjectStage {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @db.VarChar(160)
  description String?         @db.Text
  weight      Decimal         @db.Decimal(5, 2)
  startsAt    DateTime?       @map("starts_at") @db.Date
  endsAt      DateTime?       @map("ends_at") @db.Date
  sortOrder   Int             @map("sort_order")
  updates     ProjectUpdate[]

  @@map("project_stages")
}

model ProjectUpdate {
  id          String         @id @default(uuid()) @db.Uuid
  stageId     String         @map("stage_id") @db.Uuid
  title       String         @db.VarChar(180)
  description String         @db.Text
  progress    Decimal        @db.Decimal(5, 2)
  occurredAt  DateTime       @map("occurred_at") @db.Date
  publishedAt DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  stage       ProjectStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  media       ProjectMedia[]

  @@index([publishedAt])
  @@map("project_updates")
}

model ProjectMedia {
  id        String        @id @default(uuid()) @db.Uuid
  updateId  String        @map("update_id") @db.Uuid
  url       String        @db.Text
  altText   String        @map("alt_text") @db.VarChar(220)
  sortOrder Int           @map("sort_order")
  update    ProjectUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@map("project_media")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String   @map("entity_id") @db.VarChar(100)
  before      Json?
  after       Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ContractTemplate {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @db.VarChar(60)
  name        String     @db.VarChar(160)
  version     Int
  content     String     @db.Text
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  contracts   Contract[]

  @@unique([code, version])
  @@map("contract_templates")
}

model Contract {
  id            String           @id @default(uuid()) @db.Uuid
  saleId        String           @map("sale_id") @db.Uuid
  templateId    String           @map("template_id") @db.Uuid
  status        ContractStatus   @default(DRAFT)
  documentUrl   String?          @map("document_url") @db.Text
  generatedAt   DateTime?        @map("generated_at") @db.Timestamptz(6)
  signedAt      DateTime?        @map("signed_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  sale          Sale             @relation(fields: [saleId], references: [id], onDelete: Restrict)
  template      ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  acceptances   LegalAcceptance[]

  @@index([status, createdAt])
  @@index([saleId])
  @@map("contracts")
}

model LegalAcceptance {
  id          String    @id @default(uuid()) @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  contractId  String?   @map("contract_id") @db.Uuid
  type        String    @db.VarChar(80)
  version     String    @db.VarChar(40)
  acceptedAt  DateTime  @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ipAddress   String?   @map("ip_address") @db.Inet
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  evidence    Json?
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Restrict)
  contract    Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)

  @@index([memberId, acceptedAt])
  @@map("legal_acceptances")
}
